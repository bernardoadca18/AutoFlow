# =============================================================================
# AutoFlow Pro - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values
# cp .env.example .env

# Database Configuration
# =============================================================================
POSTGRES_DB=autoflow_db
POSTGRES_USER=postgres
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_PORT=5433

# Backend Node.js (API)
# =============================================================================
NODE_API_PORT=3001
DATABASE_URL=postgresql://postgres:CHANGE_ME_SECURE_PASSWORD@db:5432/autoflow_db?schema=public
# Generate a secure random string (min 32 chars): openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Backend Django (Control Plane)
# =============================================================================
# Generate a secure Django secret: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=AutoFlow Pro

# pgAdmin (Optional)
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@autoflowpro.com
PGADMIN_DEFAULT_PASSWORD=admin123
